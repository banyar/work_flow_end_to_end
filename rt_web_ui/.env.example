# RT External API (noc_automation). If RT_WEB_UI_API_URL is empty,
# http://localhost:${DOMAIN_PORT}/api/v1/cpe/remote-resolve is used.
RT_WEB_UI_API_URL=http://localhost:8001/api/v1/cpe/remote-resolve
# Bearer token; falls back to DEFAULT_TOKEN
RT_WEB_UI_API_TOKEN=
RT_WEB_UI_API_TIMEOUT=30s

# final.html section 1 gates
RT_WEB_UI_NOC_QUEUE=Network Operation Center (NOC)
# ticket status must be one of these (case-insensitive, spaces = '_')
RT_WEB_UI_ALLOWED_TICKET_STATUSES=new,in_progress,re-open,re-open-1,re-open-2,re-open-3,re-open-4,re-open-5
# compared ignoring case, spaces, '-' and '_'
RT_WEB_UI_ELIGIBLE_SERVICE_TYPES=MNet,MNet Plus,G2 Net,G2 Plus
# custom_fields keys; any non-empty value = OPI customer = no processing
RT_WEB_UI_OPI_FIELDS=opi_site_code

# Same database as noc_automation (pipeline_runs / pipeline_run_events)
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_USERNAME=
MYSQL_DB_PASSWORD=
MYSQL_DB_DATABASE=rt5
